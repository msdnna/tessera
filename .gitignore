# Env / secrets
.env
backend/.env
deploy/.env

# Prod image tarballs (built locally, shipped to the server)
deploy/dist/

# Go build artifacts
backend/tessera
backend/migrate
backend/*.out
backend/cover.html

# Attachment storage (dev default UPLOAD_DIR)
backend/uploads/
uploads/

# Node / frontend
node_modules/
frontend/dist/
# Coverage reports (vitest / go tool cover)
frontend/coverage/
backend/coverage.out
backend/cover.html
.yarn/*
!.yarn/patches
.pnp.*
yarn-error.log
# Yarn Berry lives under frontend/ — same rules, anchored there (install-state.gz
# is machine-local install cache, regenerated on every yarn run).
frontend/.yarn/*
!frontend/.yarn/patches
frontend/.pnp.*

# Desktop release artifacts belong in desktop-dist/ (bind-mounted, gitignored),
# never in the tracked desktop/ source dir — keep stray binaries out of git.
desktop/*.exe
desktop/*.exe.sig
desktop/*.deb
desktop/*.AppImage
desktop/*.AppImage.sig
desktop/latest.json

# Android (Phase 8)
android/build/
android/local.properties
android/local.env
*.apk

# Editor / OS
.DS_Store
.idea/
*.swp

# Desktop (Tauri) release output (built + published, not tracked)
desktop-dist/
