# Env / secrets
.env
backend/.env
deploy/.env

# Prod image tarballs (built locally, shipped to the server)
deploy/dist/

# Go build artifacts
backend/tessera
backend/migrate
backend/*.out
backend/cover.html

# Attachment storage (dev default UPLOAD_DIR)
backend/uploads/
uploads/

# Node / frontend
node_modules/
frontend/dist/
# Coverage reports (vitest / go tool cover / jacoco / aggregated)
frontend/coverage/
backend/coverage.out
backend/cover.html
mcp/coverage.out
mcp/cover.html
reports/
_badges/

# SAST/SCA scanner binaries (#2936) — pinned by tools/install-scanners.sh,
# fetched on demand rather than vendored.
tools/bin/
.yarn/*
!.yarn/patches
.pnp.*
yarn-error.log
# Yarn Berry lives under frontend/ — same rules, anchored there (install-state.gz
# is machine-local install cache, regenerated on every yarn run).
frontend/.yarn/*
!frontend/.yarn/patches
frontend/.pnp.*

# Desktop release artifacts belong in desktop-dist/ (bind-mounted, gitignored),
# never in the tracked desktop/ source dir — keep stray binaries out of git.
desktop/*.exe
desktop/*.exe.sig
desktop/*.deb
desktop/*.AppImage
desktop/*.AppImage.sig
desktop/latest.json

# Android (Phase 8)
android/build/
android/local.properties
android/local.env
*.apk

# Firebase (background push). google-services.json is tied to one Firebase
# project, and a service-account key is a server credential — neither belongs in
# the repo. Point the backend at its key with FCM_CREDENTIALS_FILE.
android/app/google-services.json
*-service-account*.json

# Local DB/uploads backups (never commit — may hold real user data)
backup/
*.tar.zst

# Local compose overrides (private hosts, extra ports, etc.)
docker-compose.override.yml

# Editor / OS
.DS_Store
.idea/
*.swp
# Windows "mark of the web" alternate-data-stream sidecars (WSL)
*:Zone.Identifier
*Zone.Identifier

# Desktop (Tauri) release output (built + published, not tracked)
desktop-dist/

# Playwright web e2e (#2710): reports, traces and the per-run seed/session are
# all generated artifacts — the suite recreates them on every run.
frontend/test-results/
frontend/playwright-report/
frontend/blob-report/
frontend/e2e/.auth/

# Claude Design sync (#2950): staged converter + its deps, build output, machine
# state. The durable sync inputs under frontend/.design-sync/ (config.json,
# NOTES.md, conventions.md, previews/) ARE committed.
frontend/.ds-sync/
frontend/ds-bundle/
frontend/.design-sync/.cache/
frontend/.design-sync/learnings/
frontend/.design-sync/node_modules
frontend/design-system/dist/
# symlink → ../.ds-sync/node_modules (git sees a link, not a dir, so node_modules/ misses it)
frontend/design-system/node_modules
# Bytecode cache of the conversion sidecar's tests (converter/server_test.py)
__pycache__/
*.pyc
