# Tessera production env — copy to deploy/.env on the SERVER and fill in.
#   cp .env.example .env && chmod 600 .env && nano .env
# NEVER commit the real .env. Secrets: generate, don't reuse dev values.

# ── Public address ─────────────────────────────────────────
# DNS name pointing at this VDS. Caddy issues a Let's Encrypt cert for it.
DOMAIN=tessera.msdnna.website
ACME_EMAIL=you@example.com
# Externally reachable base URL — used to build email links. Match DOMAIN.
PUBLIC_URL=https://tessera.msdnna.website

# ── Images (set by deploy/build-and-save.sh output) ────────
BACKEND_IMAGE=tessera-backend:0.45.1
FRONTEND_IMAGE=tessera-frontend:0.74.1

# ── Postgres ───────────────────────────────────────────────
POSTGRES_USER=tessera
POSTGRES_PASSWORD=        # openssl rand -base64 24
POSTGRES_DB=tessera

# ── Secrets (REQUIRED — prod fails closed without these) ───
JWT_SECRET=               # openssl rand -hex 32
# Encrypts stored GitLab PATs at rest. Independent from JWT_SECRET.
# WARNING: rotating this makes already-stored integration tokens undecryptable.
ENCRYPTION_KEY=           # openssl rand -hex 32

# ── Runtime ────────────────────────────────────────────────
TZ=Europe/Moscow

# ── SMTP (optional) ────────────────────────────────────────
# Leave blank to run without email: verification/invite/reset links are logged
# (docker compose logs backend) instead of sent. First registered user = admin.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=tessera@example.com
