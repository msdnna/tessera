# Tessera production env — copy to deploy/.env on the SERVER and fill in.
#   cp .env.example .env && chmod 600 .env && nano .env
# NEVER commit the real .env. Secrets: generate, don't reuse dev values.

# ── Public address ─────────────────────────────────────────
# DNS name pointing at this VDS. Caddy issues a Let's Encrypt cert for it.
DOMAIN=tessera.msdnna.website
ACME_EMAIL=you@example.com
# Externally reachable base URL — used to build email links. Match DOMAIN.
PUBLIC_URL=https://tessera.msdnna.website

# ── Images (set by deploy/build-and-save.sh output) ────────
BACKEND_IMAGE=tessera-backend:0.45.1
FRONTEND_IMAGE=tessera-frontend:0.74.1

# ── Postgres ───────────────────────────────────────────────
POSTGRES_USER=tessera
POSTGRES_PASSWORD=        # openssl rand -base64 24
POSTGRES_DB=tessera

# ── Secrets (REQUIRED — prod fails closed without these) ───
JWT_SECRET=               # openssl rand -hex 32
# Encrypts stored GitLab PATs at rest. Independent from JWT_SECRET.
# WARNING: rotating this makes already-stored integration tokens undecryptable.
ENCRYPTION_KEY=           # openssl rand -hex 32

# ── Conferences / LiveKit (REQUIRED — compose refuses to start without) ──
# Credentials of the video SFU. The secret signs the access tokens the backend
# mints for participants: whoever holds it can join any meeting on this server,
# so treat it exactly like JWT_SECRET.
#   LIVEKIT_API_KEY:     openssl rand -hex 16
#   LIVEKIT_API_SECRET:  openssl rand -hex 32
# Both are deliberately without defaults — a shipped default secret would make
# every installation's meetings joinable by anyone who read this file.
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
# Where the backend calls the SFU's management API (compose network, internal).
# Change only if you run the SFU outside this stack.
LIVEKIT_URL=http://livekit:7880
# What the backend gives the browser as the SFU address. Empty = same origin +
# /livekit, i.e. through Caddy on 443 — correct for this deployment. Set it only
# if the SFU sits behind a different name than DOMAIN.
LIVEKIT_PUBLIC_URL=

# ── Runtime ────────────────────────────────────────────────
TZ=Europe/Moscow

# ── SMTP (optional) ────────────────────────────────────────
# Leave blank to run without email: verification/invite/reset links are logged
# (docker compose logs backend) instead of sent. First registered user = admin.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=tessera@example.com
