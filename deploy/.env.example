# Tessera production env — copy to deploy/.env on the SERVER and fill in.
#   cp .env.example .env && chmod 600 .env && nano .env
# NEVER commit the real .env. Secrets: generate, don't reuse dev values.

# ── Public address ─────────────────────────────────────────
# DNS name pointing at this VDS. Caddy issues a Let's Encrypt cert for it.
DOMAIN=tessera.msdnna.website
ACME_EMAIL=you@example.com
# Externally reachable base URL — used to build email links. Match DOMAIN.
PUBLIC_URL=https://tessera.msdnna.website

# ── Images (set by deploy/build-and-save.sh output) ────────
BACKEND_IMAGE=tessera-backend:0.108.0
FRONTEND_IMAGE=tessera-frontend:0.185.0

# ── Postgres ───────────────────────────────────────────────
POSTGRES_USER=tessera
POSTGRES_PASSWORD=        # openssl rand -base64 24
POSTGRES_DB=tessera

# ── Secrets (REQUIRED — prod fails closed without these) ───
JWT_SECRET=               # openssl rand -hex 32
# Encrypts stored GitLab PATs at rest. Independent from JWT_SECRET.
# WARNING: rotating this makes already-stored integration tokens undecryptable.
ENCRYPTION_KEY=           # openssl rand -hex 32

# ── Conferences / LiveKit (REQUIRED — compose refuses to start without) ──
# Credentials of the video SFU. The secret signs the access tokens the backend
# mints for participants: whoever holds it can join any meeting on this server,
# so treat it exactly like JWT_SECRET.
#   LIVEKIT_API_KEY:     openssl rand -hex 16
#   LIVEKIT_API_SECRET:  openssl rand -hex 32
# Both are deliberately without defaults — a shipped default secret would make
# every installation's meetings joinable by anyone who read this file.
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
# Where the backend calls the SFU's management API (compose network, internal).
# Change only if you run the SFU outside this stack.
LIVEKIT_URL=http://livekit:7880
# What the backend hands the browser as the SFU signalling address. REQUIRED for
# conferences: the client connects to exactly this URL (no same-origin fallback),
# and the token endpoint answers 503 while it is empty. Set it to wss://<DOMAIN>/
# livekit — through Caddy on 443, which reverse-proxies /livekit/* to the SFU.
LIVEKIT_PUBLIC_URL=wss://example.com/livekit

# ── Conference recording (optional, OFF by default) ────────
# Recording needs Redis: it is the only channel between the SFU and the egress
# worker, and the SFU dispatches a recording request nowhere without it. Setting
# this alone is NOT enough and will break the stack on the next restart — the SFU
# would be pointed at a Redis that the `recording` profile never started. Turn the
# whole thing on with one command instead, and read deploy/README.md first: a
# non-empty value also switches the SFU to multi-node mode, which makes Redis a
# dependency of conferences as a whole, not just of recording.
#
#   LIVEKIT_REDIS_HOST=redis:6379 docker compose --profile recording up -d
#
#LIVEKIT_REDIS_HOST=redis:6379
#
# The recording is composed by our own page so it looks like the room in the
# browser — shared screen full-bleed at 1080p, camera as a corner PiP, avatars
# for participants with no video — instead of egress's dark 720p grid. This is
# the internal URL egress opens over the compose network; the default points at
# the `frontend` container and is correct for this stack. Set it empty to fall
# back to egress's built-in grid.
#RECORDING_TEMPLATE_URL=http://frontend/rec/egress

# ── Runtime ────────────────────────────────────────────────
TZ=Europe/Moscow

# ── SMTP (optional) ────────────────────────────────────────
# Leave blank to run without email: verification/invite/reset links are logged
# (docker compose logs backend) instead of sent. First registered user = admin.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=tessera@example.com
