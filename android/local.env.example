# Android build — machine-specific configuration.
# Copy to local.env and adjust:  cp local.env.example local.env

# Android SDK path (required)
ANDROID_HOME=$HOME/Android/Sdk

# Java home (required, must be Java 17+)
JAVA_HOME=/usr/lib/jvm/java-21-openjdk-amd64

# SOCKS5 proxy for Gradle — leave empty if not needed
SOCKS_PROXY_HOST=
SOCKS_PROXY_PORT=1080

# ── Release signing (only needed for `make android-release`) ────────────────
# ANDROID_KEYSTORE_FILE=$HOME/tessera.jks
# ANDROID_KEYSTORE_PASSWORD=
# ANDROID_KEY_ALIAS=tessera
# ANDROID_KEY_PASSWORD=
