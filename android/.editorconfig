root = true

[*]
charset = utf-8
end_of_line = lf
indent_size = 4
indent_style = space
insert_final_newline = true
trim_trailing_whitespace = true
max_line_length = 140

[*.{kt,kts}]
ktlint_code_style = android_studio
# Compose-функции по конвенции в PascalCase — отключаем правило camelCase.
ktlint_standard_function-naming = disabled
# Compose-сигнатуры часто содержат дюжину параметров — стандарт ktlint режет
# их до неудобства; не размазываем каждый Composable на 30 строк.
ktlint_standard_parameter-list-wrapping = disabled
ktlint_standard_argument-list-wrapping = disabled
ktlint_standard_trailing-comma-on-call-site = disabled
ktlint_standard_trailing-comma-on-declaration-site = disabled
# Property-name под Compose-идиомы (LocalFoo, MaterialTheme и т.п.).
ktlint_standard_property-naming = disabled
# Длину строки ловит отдельное правило (140).
ktlint_standard_max-line-length = disabled
# Multiline expression wrapping слишком агрессивен для лямбд Compose.
ktlint_standard_multiline-expression-wrapping = disabled
ktlint_standard_no-wildcard-imports = disabled
ktlint_standard_function-signature = disabled
ktlint_standard_multiline-if-else = disabled
ktlint_standard_function-expression-body = disabled
# Backing property `_foo` для MutableStateFlow — Android-конвенция.
ktlint_standard_backing-property-naming = disabled

[*.{json,yml,yaml,xml,html}]
indent_size = 2

[Makefile]
indent_style = tab
