<?xml version="1.0" encoding="utf-8"?>
<!--
    Языки, которые приложение действительно везёт с собой. Нужен системным
    настройкам «Язык приложения» (Android 13+) и линту, который иначе считает
    values-en/ неполной локалью. Сам выбор языка приложение берёт из профиля
    (user_preferences.language), а не из системы — см. util/Languages.kt.
-->
<locale-config xmlns:android="http://schemas.android.com/apk/res/android">
    <locale android:name="ru" />
    <locale android:name="en" />
</locale-config>
