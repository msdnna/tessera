<?xml version="1.0" encoding="utf-8"?>
<!--
  Правила выгрузки данных приложения на Android 12+ (#2932).

  Сессия живёт в DataStore (`AppPreferences`, файл `datastore/tessera.preferences_pb`):
  там access- и refresh-токен. Без этого файла каталог данных уезжает в облачный
  бэкап целиком, то есть refresh-токен попадает в Google Drive пользователя и в
  перенос устройство→устройство — а восстановление такого бэкапа на чужом аппарате
  даёт живую сессию без пароля и без второго фактора.

  Исключаем каталог целиком, а не один ключ: DataStore пишет один protobuf-файл на
  всё хранилище, вынуть из него токены построчно нельзя. Цена — настройки темы и
  раскрытые узлы дерева не переезжают на новый телефон; сессию всё равно пришлось
  бы восстанавливать входом.

  Остальное (кэш вложений и т.п.) платформа не бэкапит и так.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="file" path="datastore" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="file" path="datastore" />
    </device-transfer>
</data-extraction-rules>
