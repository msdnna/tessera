FROM golang:1.25-alpine AS builder

WORKDIR /app
RUN apk add --no-cache git

COPY go.mod go.sum ./
RUN go mod download

# Build metadata surfaced by GET /api/version. The build context is ./backend
# (no .git), so these are passed in from deploy/build-and-save.sh; both default
# to empty and the API omits an empty field.
ARG GIT_COMMIT=
ARG BUILD_DATE=

COPY . .
RUN CGO_ENABLED=0 GOOS=linux go build \
      -ldflags="-s -w -X main.commit=${GIT_COMMIT} -X main.builtAt=${BUILD_DATE}" \
      -o tessera . \
 && CGO_ENABLED=0 GOOS=linux go build -ldflags="-s -w" -o migrate ./cmd/migrate

# Staged here only to be copied into the final image: distroless has no shell,
# so `RUN mkdir` is impossible there.
RUN mkdir -p /out/uploads

# Distroless: no shell, minimal attack surface. Static binary (CGO disabled).
FROM gcr.io/distroless/static-debian12

COPY --from=builder /app/tessera /tessera
COPY --from=builder /app/migrate /migrate

# Mount point of the backend_uploads volume. Docker seeds a *fresh* named volume
# from the image at this path — owner included — so the directory has to exist
# here and belong to nonroot (65532). Without it the daemon creates the mount
# point itself as root:root and every upload fails with EACCES (#2820). UID as a
# number, not `nonroot:nonroot`: it must not depend on parsing /etc/passwd.
# No VOLUME instruction on purpose — it spawns anonymous volumes on plain
# `docker run`.
COPY --from=builder --chown=65532:65532 /out/uploads /data/uploads

EXPOSE 8080
USER nonroot:nonroot
ENTRYPOINT ["/tessera"]
