FROM golang:1.25-alpine AS builder

WORKDIR /app
RUN apk add --no-cache git

COPY go.mod go.sum ./
RUN go mod download

COPY . .
RUN CGO_ENABLED=0 GOOS=linux go build -ldflags="-s -w" -o tessera . \
 && CGO_ENABLED=0 GOOS=linux go build -ldflags="-s -w" -o migrate ./cmd/migrate

# Distroless: no shell, minimal attack surface. Static binary (CGO disabled).
FROM gcr.io/distroless/static-debian12

COPY --from=builder /app/tessera /tessera
COPY --from=builder /app/migrate /migrate

EXPOSE 8080
USER nonroot:nonroot
ENTRYPOINT ["/tessera"]
